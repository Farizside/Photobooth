# Database (cocok dengan docker-compose.yml)
DATABASE_URL="postgresql://photobooth:photobooth@localhost:5432/photobooth?schema=public"

# Sesi admin (isi dengan string acak panjang)
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Penyimpanan foto
# development: simpan ke folder lokal. produksi: ganti ke "s3" (mis. Cloudflare R2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Hanya dipakai bila STORAGE_DRIVER="s3"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Akun owner awal untuk seed
SEED_OWNER_EMAIL="owner@photobooth.local"
SEED_OWNER_PASSWORD="ganti-password-ini"
